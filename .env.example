# Copy to .env in the project root and edit. Never commit .env.
DATABASE_URL=postgresql://incident:CHANGE_ME@localhost:5432/incidents

# Embeddings (Ollama). EMBED_DIM must equal the model's vector size: embeddinggemma = 768.
EMBED_MODEL=embeddinggemma
EMBED_DIM=768
OLLAMA_URL=http://localhost:11434

# Parsing: auto (try Docling, fall back to pypdf / python-docx) | docling | pypdf
PARSER=auto
OCR=0
CHUNK_MAX_TOKENS=512

SITE_ID=WH-07 Columbus
# MAX_UPLOAD_MB=100
# INCIDENT_STORAGE=storage
